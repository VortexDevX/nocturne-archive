# Production: Vercel + MongoDB Atlas + a PRIVATE Cloudflare R2 bucket.
# Copy values into Vercel Project Settings > Environment Variables.
# Use separate Atlas databases/buckets for Preview and Production.
# Vercel sets NODE_ENV automatically; do not override it.

MONGODB_URI=
MONGODB_DB_NAME=nocturne
# Generate at least 32 random bytes. Keep existing value to preserve login cookies.
JWT_SECRET=
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Required on Vercel. Set local only for filesystem development.
STORAGE_BACKEND=r2
# Production must not depend on deployed local files.
FILESYSTEM_FALLBACK=false

# Server-only, bucket-scoped Object Read & Write credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Replace with the actual private bucket name.
R2_BUCKET_NAME=nocturne-archive-prod
# Optional: eu or fedramp. Leave blank for the default jurisdiction.
R2_JURISDICTION=

# No public bucket URL is needed. Keep r2.dev/public access disabled.
# Local development: use your existing .env and FILESYSTEM_FALLBACK=true
# only while migrating local development data.
